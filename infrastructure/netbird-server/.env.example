# Public hostname of the NetBird server (A record -> instance public IP, DNS only)
NETBIRD_DOMAIN=netbird.domain.tld
# Let's Encrypt account email for both Traefik resolvers
ACME_EMAIL=you@domain.tld

# Routed "services" network, owned by this stack. Must be private and must not
# overlap any NetBird client's local or Docker networks.
SERVICES_SUBNET=10.110.2.0/24
SERVICES_GATEWAY=10.110.2.1
# Traefik's address on "services"; NetBird-only hostnames (matrix, chat, rtc) point here
TRAEFIK_SERVICES_IP=10.110.2.20
