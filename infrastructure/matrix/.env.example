# Hostnames: Cloudflare A records -> Traefik's IP on the routed "services" network (DNS only)
MATRIX_HOST=matrix.domain.tld
CHAT_HOST=chat.domain.tld
RTC_HOST=rtc.domain.tld

# LiveKit's static IP on the routed "services" network. Must match rtc.node_ip in livekit/livekit.yaml.
LIVEKIT_IP=10.110.2.30

# Who may connect through Traefik: NetBird peers, the routed network (masqueraded
# NetBird traffic) and Docker containers (lk-jwt-service calls back through Traefik).
ALLOWED_RANGES=100.64.0.0/10,10.110.2.0/24,172.16.0.0/12

# Existing Traefik (NetBird's). The resolver must use DNS-01: the hostnames
# resolve to a private IP, so TLS/HTTP challenges can't validate.
TRAEFIK_NETWORK=netbird_netbird
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt-dns

# Secrets: openssl rand -hex 24  (Postgres)
#          docker run --rm livekit/livekit-server:latest generate-keys  (LiveKit)
POSTGRES_PASSWORD=
LIVEKIT_KEY=
LIVEKIT_SECRET=
