HOSTNAME=pc-hostname
NB_SETUP_KEY=XXXXX-XX-XXX
NB_MANAGEMENT_URL=https://netbird.domain.tld

# Routed "services" network. Pick a private /24 that is unique per host and
# doesn't overlap any NetBird client's local or Docker networks.
SERVICES_SUBNET=10.110.2.0/24
SERVICES_GATEWAY=10.110.2.1
NETBIRD_CLIENT_IP=10.110.2.10

# Set to true on the host running infrastructure/netbird-server, which creates
# "services" itself (SERVICES_SUBNET must then match that stack's .env).
#SERVICES_EXTERNAL=true
