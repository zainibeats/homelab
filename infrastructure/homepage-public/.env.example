# For docker-compose.yaml
HOMEPAGE_ALLOWED_HOSTS="172.23.20.30:7575,homepage.domain.tld"

# For Widgets.yaml
HOMEPAGE_VAR_OWM_KEY=your_openweathermap_api_key_here
HOMEPAGE_VAR_OWM_LABEL="Los Angeles, CA"
HOMEPAGE_VAR_OWM_LAT=34.052235
HOMEPAGE_VAR_OWM_LONG=-118.243683

# For services.yaml
HOMEPAGE_VAR_DOMAIN=domain.tld
HOMEPAGE_VAR_APP_HOST=172.20.50.30

# For settings.yaml
HOMEPAGE_VAR_FINNHUB_KEY=your_finnhub_api_key_here
HOMEPAGE_VAR_WEATHER_KEY=your_weather_api_key_here

# Traefik label
DOMAIN=domain.tld
SUBDOMAIN=subdomain
