# Hostname: Cloudflare A record -> Traefik's IP on the routed "services" network (DNS only)
HOMEPAGE_HOST=home.domain.tld

# Homepage's static IP on the routed "services" network
HOMEPAGE_IP=10.110.2.44

# Owner of config/ in the clone (the entrypoint chowns config/ to this)
PUID=1000
PGID=1000

# Who may connect through Traefik: NetBird peers and the routed network (masqueraded NetBird traffic)
ALLOWED_RANGES=100.64.0.0/10,10.110.2.0/24

# Existing Traefik (NetBird's). The resolver must use DNS-01: the hostname
# resolves to a private IP, so TLS/HTTP challenges can't validate.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt-dns

# Substituted into config/ as {{HOMEPAGE_VAR_...}}
HOMEPAGE_VAR_TITLE=domain.tld
HOMEPAGE_VAR_CHAT_HOST=chat.domain.tld
HOMEPAGE_VAR_NEKO_HOST=neko.domain.tld
HOMEPAGE_VAR_MINECRAFT_HOST=minecraft.domain.tld
HOMEPAGE_VAR_MINECRAFT_IP=10.110.2.40
HOMEPAGE_VAR_PALWORLD_IP=10.110.2.41
HOMEPAGE_VAR_VALHEIM_IP=10.110.2.42
