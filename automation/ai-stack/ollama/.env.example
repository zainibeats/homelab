MODELS_DIR=/home/zainibeats/llms
# Listen on all interfaces so Open WebUI reaches Ollama via host.docker.internal.
# This also exposes port 11434 on the LAN; restrict it with the host firewall.
OLLAMA_HOST=0.0.0.0:11434
# Optional: host path for downloaded models (e.g. a dedicated disk).
# Unset keeps them in the named volume `ollama`.
# OLLAMA_DATA=/var/lib/ollama/models
# Optional: default context window in tokens (Ollama uses 4096 on GPUs under 24 GB).
# Agents like Hermes Agent need 64000+.
# OLLAMA_CONTEXT_LENGTH=65536
# Optional: quantize the KV cache so long contexts fit in VRAM (needs flash attention).
# q8_0 halves its size, q4_0 quarters it.
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
