# Pinned tool versions for the homelab-toolbox image.
# build.sh passes each KEY=value line to `docker build` as a --build-arg.
# Plain version numbers, no leading "v". Rebuild after changing.

# OpenTofu: https://github.com/opentofu/opentofu/releases
TOFU_VERSION=1.13.9
# kubectl: https://dl.k8s.io/release/stable.txt
KUBECTL_VERSION=1.37.2
# Helm: https://github.com/helm/helm/releases
HELM_VERSION=4.3.2
# ansible-core: https://pypi.org/project/ansible-core/
ANSIBLE_CORE_VERSION=2.22.0
