# homelab-toolbox secrets, passed to the container with `docker run --env-file`.
# Copy to ~/.config/homelab/secrets.env with mode 600. Never commit the real file.
# Format: KEY=value, one per line. No quotes and no `export`; Docker takes values literally.

# Proxmox API token for the bpg/proxmox OpenTofu provider (user@realm!tokenid=secret).
# PROXMOX_VE_API_TOKEN=
