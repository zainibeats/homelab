    {
      "type": "stat",
      "id": 7,
      "title": "Scrape targets down",
      "description": "Prometheus scrape targets currently failing. Details in the Target health panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
