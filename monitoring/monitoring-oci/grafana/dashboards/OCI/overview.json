    {
      "type": "row",
      "id": 14,
      "title": "Containers",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "id": 15,
      "title": "Containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, container_label_com_docker_compose_project) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, container_label_com_docker_compose_project) (container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
