proxmox_endpoint  = "https://pve.example.lan:8006/"
proxmox_api_token = "terraform@pve!tf=00000000-0000-0000-0000-000000000000"
node_name         = "compute"
template_vm_id    = 110
ipv4_gateway      = "172.20.50.1"
dns_servers       = ["172.20.50.1"]

# One server + two agents, the same shape as production's start.
nodes = {
  k3s-lab-1 = { vm_id = 211, role = "server", ipv4_cidr = "172.20.50.211/24", cores = 2, memory_mb = 4096, disk_gb = 32 }
  k3s-lab-2 = { vm_id = 212, role = "agent", ipv4_cidr = "172.20.50.212/24", cores = 4, memory_mb = 8192, disk_gb = 40 }
  k3s-lab-3 = { vm_id = 213, role = "agent", ipv4_cidr = "172.20.50.213/24", cores = 4, memory_mb = 8192, disk_gb = 40 }
}

# Optional overrides. Defaults are in variables.tf.
# proxmox_insecure   = true
# vm_datastore_id    = "local-lvm"
# disk_interface     = "scsi0"      # must match the template's boot disk
# network_bridge     = "vmbr0"
# vlan_id            = 20           # only if the bridge needs a tag for the homelab VLAN
# admin_username     = "debian"
# public_key_path    = "~/.ssh/id_ed25519.pub"
# start_on_boot      = false

# Set true if the template has qemu-guest-agent, or after the Ansible base
# playbook has installed it, then apply again (the VMs restart).
# qemu_agent_enabled = false
