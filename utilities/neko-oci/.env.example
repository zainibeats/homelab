TZ=America/Los_Angeles

# Hostname: Cloudflare A record -> Traefik's IP on the routed "services" network (DNS only)
NEKO_HOST=neko.domain.tld

# Neko's static IP on the routed "services" network, also advertised to WebRTC clients
NEKO_IP=10.110.2.43

# Who may connect through Traefik: NetBird peers and the routed network (masqueraded NetBird traffic)
ALLOWED_RANGES=100.64.0.0/10,10.110.2.0/24

# Existing Traefik (NetBird's). The resolver must use DNS-01: the hostname
# resolves to a private IP, so TLS/HTTP challenges can't validate.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt-dns

# VPN (Gluetun) for the browser's traffic. See the Gluetun wiki for each provider:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
SERVER_COUNTRIES=United States

# Passwords for guests and for the admin
NEKO_MEMBER_MULTIUSER_USER_PASSWORD=
NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD=
