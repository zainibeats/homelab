# Timezone Configuration
TZ=America/Los_Angeles

# VPN Configuration (Gluetun)
VPN_SERVICE_PROVIDER=PROVIDER # protonvpn, mullvad, nordvpn, etc.
VPN_TYPE=wireguard # wireguard, openvpn, etc.

# WireGuard Keys (replace with your actual keys)
WIREGUARD_PUBLIC_KEY="WIREGUARD_PUBLIC_KEY"
WIREGUARD_PRIVATE_KEY="WIREGUARD_PRIVATE_KEY"

# VPN Server Configuration
SERVER_COUNTRIES=SERVER_COUNTRIES # Sweden, Canada, etc. 

# Neko Configs
NEKO_MEMBER_MULTIUSER_USER_PASSWORD="NEKO_MEMBER_MULTIUSER_USER_PASSWORD" # Password for regular users
NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD="NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD" # Password for the admin user
NEKO_WEBRTC_NAT1TO1=NEKO_WEBRTC_NAT1TO1 # IP address of the server
NEKO_WEBRTC_IP_RETRIEVAL_URL=https://checkip.amazonaws.com # URL used to look up the external IP address (Neko's default)